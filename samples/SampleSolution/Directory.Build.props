<Project>

  <!--
    Configuración común de la solución de ejemplo.

    La referencia a Lainco.Analyzers está acá para que la tomen todos los proyectos sin
    repetirla en cada .csproj. Es la misma forma en que la van a referenciar los
    repositorios reales.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Deshabilitado a propósito: las entidades NHibernate se construyen por reflexión
      y sus properties se asignan desde los mapeos, así que el análisis de nulabilidad
      produce advertencias del compilador que no corresponden a ninguna regla LAIN.
    -->
    <Nullable>disable</Nullable>

    <!--
      Fase 2, tarea 3: a Sonar solo deben llegar reglas LAIN. Desde la 0.3.0 no se configura
      acá: el paquete trae una base que apaga los analyzers del SDK (CA####, IDE####) y las
      advertencias del compilador (CS####), y fija EnableNETAnalyzers, EnforceCodeStyleInBuild
      y AnalysisLevel (ver "Qué apaga el paquete" en docs/nuevo-repositorio.md).
    -->

    <!--
      Fase 4, tarea 2: proyecto de SonarQube del que se bajan los issues aceptados antes
      de cada build local (lo hace el .targets del paquete Lainco.Analyzers). En CI no
      corre. Cada programador necesita la variable de entorno LAINCO_SONAR_TOKEN.
    -->
    <LaincoSonarProyecto>revertpablo_Lainco-quality</LaincoSonarProyecto>
  </PropertyGroup>

  <ItemGroup>
    <!--
      El paquete trae los analyzers y el .globalconfig con las severidades.
      PrivateAssets="all" evita que la referencia se propague a quien consuma estos
      proyectos: cada repositorio referencia el paquete por su cuenta.
    -->
    <PackageReference Include="Lainco.Analyzers" Version="0.3.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
