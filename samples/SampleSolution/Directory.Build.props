<Project>

  <!--
    Configuración común de la solución de ejemplo.

    La referencia a Lainco.Analyzers está acá para que la tomen todos los proyectos sin
    repetirla en cada .csproj. Es la misma forma en que la van a referenciar los
    repositorios reales.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Deshabilitado a propósito: las entidades NHibernate se construyen por reflexión
      y sus properties se asignan desde los mapeos, así que el análisis de nulabilidad
      produce advertencias del compilador que no corresponden a ninguna regla LAIN.
    -->
    <Nullable>disable</Nullable>

    <!--
      Fase 2, tarea 3: a Sonar solo deben llegar reglas LAIN.

      Los analyzers del SDK (CA####) y las reglas de estilo (IDE####) se apagan acá
      para que el análisis no traiga issues que nadie eligió. Es una medida gruesa y
      temporal: en la Fase 8 estas reglas entran al inventario (decisión D8.3) y se
      reemplaza esto por la lista explícita de las que el equipo haya incorporado.
    -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisLevel>none</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <!--
      El paquete trae los analyzers y el .globalconfig con las severidades.
      PrivateAssets="all" evita que la referencia se propague a quien consuma estos
      proyectos: cada repositorio referencia el paquete por su cuenta.
    -->
    <PackageReference Include="Lainco.Analyzers" Version="0.1.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
