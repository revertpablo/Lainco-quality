<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    La sample consume Lainco.Analyzers desde el feed local artifacts/nupkg, que se llena
    con:

        dotnet pack src/dotnet/Lainco.Analyzers.Package -c Release -o artifacts/nupkg

    Así se puede probar el paquete de punta a punta sin publicar una versión.
    El feed de GitHub Packages se agrega cuando se publique la primera versión
    (ver docs/publicacion-de-paquetes.md).
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="lainco-local" value="../../artifacts/nupkg" />
  </packageSources>

</configuration>
