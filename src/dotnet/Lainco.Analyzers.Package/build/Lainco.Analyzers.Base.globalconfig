# Base de severidades: todo apagado (analyzers).
#
# Principio rector (CLAUDE.md): ninguna regla está activa si alguien del equipo no la
# eligió. Este archivo apaga los diagnósticos de todos los analyzers, y
# Lainco.Analyzers.Base.Compilador.globalconfig las advertencias del compilador; el
# .globalconfig de las reglas (Lainco.Analyzers.globalconfig, que genera la app) enciende
# solo lo incorporado. Viajan juntos en el paquete y los suma Lainco.Analyzers.props
# (el del compilador, según LaincoCompiladorEnLocal).
#
# Prioridad: global_level = -1. El de las reglas tiene el nivel por defecto (0), así que
# ante una misma clave gana ese. Además, una severidad por ID (dotnet_diagnostic.X.severity)
# siempre le gana a la configuración masiva de la sección 1, esté en el archivo que esté.
# Encender una regla, entonces, no requiere tocar este archivo.
#
# Por qué un .globalconfig y no NoWarn o WarningLevel: el compilador aplica esos dos
# antes que cualquier .globalconfig (WarningLevel 0 apagaría hasta las reglas LAIN), y
# después ningún archivo podría volver a encender la regla.
#
# No alcanza a: las reglas de Sonar del análisis de CI (el escáner las configura con un
# ruleset, que tiene prioridad sobre los .globalconfig), los errores, y los avisos de
# MSBuild y NuGet (NETSDK####, NU####, MSB####), que no son del compilador.
#
# Fase 8 (docs/PLAN.md): cuando un CS####, CA#### o IDE#### se incorpore, va en el
# .globalconfig de las reglas, no acá.

is_global = true
global_level = -1

# 1. Diagnósticos de analyzers: CA y IDE del SDK, LAIN, y cualquier analyzer que llegue
#    por otro paquete. La configuración masiva no alcanza a las reglas que tienen una
#    severidad por ID ni a las que nacen apagadas (que ya están apagadas).
dotnet_analyzer_diagnostic.severity = none
