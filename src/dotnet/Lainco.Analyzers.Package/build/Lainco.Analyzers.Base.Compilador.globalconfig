# Base de severidades: advertencias del compilador de C# (CS####) apagadas.
#
# Complemento de Lainco.Analyzers.Base.globalconfig (ver su encabezado: prioridad, por qué
# no NoWarn ni WarningLevel, qué no alcanza). Está aparte para poder dejarlo afuera en los
# builds locales: con LaincoCompiladorEnLocal=true en el Directory.Build.props del
# repositorio, Lainco.Analyzers.props lo incluye solo en CI. Así el programador ve las
# advertencias del compilador en el IDE y en su build, pero no llegan a Sonar.
#
# Prioridad: global_level = -1, igual que la base. Si la app enciende un CS####, gana el
# .globalconfig de las reglas, en local y en CI.

is_global = true
global_level = -1

# La configuración masiva de dotnet_analyzer_diagnostic no alcanza a las advertencias del
# compilador, así que van una por una: todas las WRN_* de ErrorCode.cs de Roslyn, unidas
# desde Visual Studio 2019 16.11 (.NET 5 y 6) hasta main al 2026-11-03, porque algunas se
# retiran en versiones nuevas y un repositorio puede compilar con un SDK viejo. 347 códigos.
# Un código que el compilador no conoce no molesta. El test BaseGlobalconfigTests avisa si
# el Roslyn de los tests trae alguna que falte acá.
dotnet_diagnostic.CS0028.severity = none
dotnet_diagnostic.CS0067.severity = none
dotnet_diagnostic.CS0078.severity = none
dotnet_diagnostic.CS0105.severity = none
dotnet_diagnostic.CS0108.severity = none
