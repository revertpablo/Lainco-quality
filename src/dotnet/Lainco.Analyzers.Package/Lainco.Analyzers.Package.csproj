<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proyecto de empaquetado. No tiene código propio: arma el paquete NuGet con
      - los analyzers y el suppressor de issues aceptados (Fase 4) en analyzers/dotnet/cs
      - el .globalconfig con las severidades, en buildTransitive
      - sonar-sync en tools/sonar-sync, y el .targets que lo corre antes de compilar
        (Fase 4, tarea 2), en buildTransitive

    Además, después de compilar genera el catálogo de reglas, reglas-roslyn.json, junto al
    .nupkg (entrega 6.4, paso 1). No viaja dentro del paquete: es un asset del release, y lo
    lee la app de catálogo. Ver docs/catalogo-de-reglas.md.

    A partir de la Fase 6, el .globalconfig lo genera la app de catálogo a partir de las
    decisiones registradas. Por ahora se mantiene a mano.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>

    <!-- El proyecto no aporta assembly propio al paquete. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>Lainco.Analyzers</PackageId>
    <Version>0.1.1</Version>
    <Authors>Lainco</Authors>
    <Company>Lainco</Company>
    <Description>
      Reglas de análisis estático propias de Lainco para C# (LAIN###).
      Las severidades vienen en un .globalconfig incluido en el paquete.
    </Description>
    <PackageTags>analyzers;roslyn;lainco</PackageTags>

    <RepositoryUrl>https://github.com/revertpablo/Lainco-quality</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <IncludeSymbols>false</IncludeSymbols>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PrivateAssets="all" + ReferenceOutputAssembly="false": solo se usa para forzar el
      orden de compilación; el DLL se agrega a mano en el ItemGroup de abajo, en la ruta
      que espera NuGet para los analyzers.
    -->
    <ProjectReference Include="..\Lainco.Analyzers\Lainco.Analyzers.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false" />

    <ProjectReference Include="..\Lainco.Analyzers.Suppressor\Lainco.Analyzers.Suppressor.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false" />

    <!--
      Lo mismo para sonar-sync, que es net8.0. SkipGetTargetFrameworkProperties evita que
      MSBuild exija compatibilidad de target framework con este proyecto (netstandard2.0):
      no se consume su assembly, solo se necesita que esté compilado.
    -->
    <ProjectReference Include="..\..\..\tools\sonar-sync\src\Lainco.SonarSync\Lainco.SonarSync.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework" />

    <!-- Lo mismo para el generador del catálogo de reglas (net8.0), que corre en el build. -->
    <ProjectReference Include="..\..\..\tools\catalogo-reglas\src\Lainco.CatalogoReglas\Lainco.CatalogoReglas.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Lainco.Analyzers\bin\$(Configuration)\netstandard2.0\Lainco.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />

    <None Include="..\Lainco.Analyzers.Suppressor\bin\$(Configuration)\netstandard2.0\Lainco.Analyzers.Suppressor.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />

    <!--
      NuGet importa automáticamente buildTransitive/<PackageId>.props en el proyecto
      consumidor. Ese .props es el que engancha el .globalconfig.
    -->
    <None Include="build\Lainco.Analyzers.props"
          Pack="true"
          PackagePath="buildTransitive/Lainco.Analyzers.props"
          Visible="false" />

    <None Include="build\Lainco.Analyzers.globalconfig"
          Pack="true"
          PackagePath="buildTransitive/Lainco.Analyzers.globalconfig"
          Visible="false" />

    <!--
      NuGet importa buildTransitive/<PackageId>.targets al final del proyecto consumidor.
      Ese .targets corre sonar-sync desde tools/sonar-sync antes de compilar.
    -->
    <None Include="build\Lainco.Analyzers.targets"
          Pack="true"
          PackagePath="buildTransitive/Lainco.Analyzers.targets"
          Visible="false" />

    <None Include="..\..\..\tools\sonar-sync\src\Lainco.SonarSync\bin\$(Configuration)\net8.0\sonar-sync.dll;
                   ..\..\..\tools\sonar-sync\src\Lainco.SonarSync\bin\$(Configuration)\net8.0\sonar-sync.runtimeconfig.json;
                   ..\..\..\tools\sonar-sync\src\Lainco.SonarSync\bin\$(Configuration)\net8.0\sonar-sync.deps.json"
          Pack="true"
          PackagePath="tools/sonar-sync"
          Visible="false" />
  </ItemGroup>

  <!--
    Catálogo de reglas (entrega 6.4, paso 1; decisión R1). Después de compilar, el
    generador lee los descriptores de Lainco.Analyzers.dll, AnalyzerReleases y docs/rules,
    y escribe reglas-roslyn.json en la carpeta del .nupkg (la de "dotnet pack -o").

    Si una regla no cumple las convenciones (sin documentación, ID que no es LAIN###, fuera
    de AnalyzerReleases, severidad 'error'), el build falla con el detalle de cada una.
    Con -p:GenerarCatalogoDeReglas=false no se genera.
  -->
  <Target Name="GenerarCatalogoDeReglas"
          AfterTargets="Build"
          Condition="'$(GenerarCatalogoDeReglas)' != 'false'">
    <PropertyGroup>
      <_DotnetDelCatalogo>$(DOTNET_HOST_PATH)</_DotnetDelCatalogo>
      <_DotnetDelCatalogo Condition="'$(_DotnetDelCatalogo)' == ''">dotnet</_DotnetDelCatalogo>
      <_RaizDelRepositorio>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..'))</_RaizDelRepositorio>
      <_GeneradorDelCatalogo>$(_RaizDelRepositorio)tools/catalogo-reglas/src/Lainco.CatalogoReglas/bin/$(Configuration)/net8.0/catalogo-reglas.dll</_GeneradorDelCatalogo>
      <_AnalyzersDelCatalogo>$(MSBuildProjectDirectory)/../Lainco.Analyzers/bin/$(Configuration)/netstandard2.0/Lainco.Analyzers.dll</_AnalyzersDelCatalogo>
      <CatalogoDeReglas>$([MSBuild]::EnsureTrailingSlash('$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(PackageOutputPath)'))'))reglas-roslyn.json</CatalogoDeReglas>
    </PropertyGroup>

    <Exec Command="&quot;$(_DotnetDelCatalogo)&quot; &quot;$(_GeneradorDelCatalogo)&quot; --analyzers &quot;$(_AnalyzersDelCatalogo)&quot; --releases &quot;$(MSBuildProjectDirectory)/../Lainco.Analyzers&quot; --documentacion &quot;$(_RaizDelRepositorio)docs/rules&quot; --paquete $(PackageId) --version $(Version) --salida &quot;$(CatalogoDeReglas)&quot;" />
  </Target>

</Project>
