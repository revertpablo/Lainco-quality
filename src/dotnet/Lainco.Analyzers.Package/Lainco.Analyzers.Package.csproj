<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proyecto de empaquetado. No tiene código propio: arma el paquete NuGet con
      - los analyzers y el suppressor de issues aceptados (Fase 4) en analyzers/dotnet/cs
      - el .globalconfig con las severidades, en buildTransitive
      - sonar-sync en tools/sonar-sync, y el .targets que lo corre antes de compilar
        (Fase 4, tarea 2), en buildTransitive

    A partir de la Fase 6, el .globalconfig lo genera la app de catálogo a partir de las
    decisiones registradas. Por ahora se mantiene a mano.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>

    <!-- El proyecto no aporta assembly propio al paquete. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>Lainco.Analyzers</PackageId>
    <Version>0.1.0</Version>
    <Authors>Lainco</Authors>
    <Company>Lainco</Company>
    <Description>
      Reglas de análisis estático propias de Lainco para C# (LAIN###).
      Las severidades vienen en un .globalconfig incluido en el paquete.
    </Description>
    <PackageTags>analyzers;roslyn;lainco</PackageTags>

    <RepositoryUrl>https://github.com/revertpablo/Lainco-quality</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <IncludeSymbols>false</IncludeSymbols>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <!--
      PrivateAssets="all" + ReferenceOutputAssembly="false": solo se usa para forzar el
      orden de compilación; el DLL se agrega a mano en el ItemGroup de abajo, en la ruta
      que espera NuGet para los analyzers.
    -->
    <ProjectReference Include="..\Lainco.Analyzers\Lainco.Analyzers.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false" />

    <ProjectReference Include="..\Lainco.Analyzers.Suppressor\Lainco.Analyzers.Suppressor.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false" />

    <!--
      Lo mismo para sonar-sync, que es net8.0. SkipGetTargetFrameworkProperties evita que
      MSBuild exija compatibilidad de target framework con este proyecto (netstandard2.0):
      no se consume su assembly, solo se necesita que esté compilado.
    -->
    <ProjectReference Include="..\..\..\tools\sonar-sync\src\Lainco.SonarSync\Lainco.SonarSync.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="TargetFramework" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Lainco.Analyzers\bin\$(Configuration)\netstandard2.0\Lainco.Analyzers.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />

    <None Include="..\Lainco.Analyzers.Suppressor\bin\$(Configuration)\netstandard2.0\Lainco.Analyzers.Suppressor.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />

    <!--
      NuGet importa automáticamente buildTransitive/<PackageId>.props en el proyecto
      consumidor. Ese .props es el que engancha el .globalconfig.
    -->
    <None Include="build\Lainco.Analyzers.props"
          Pack="true"
          PackagePath="buildTransitive/Lainco.Analyzers.props"
          Visible="false" />

    <None Include="build\Lainco.Analyzers.globalconfig"
          Pack="true"
          PackagePath="buildTransitive/Lainco.Analyzers.globalconfig"
          Visible="false" />

    <!--
      NuGet importa buildTransitive/<PackageId>.targets al final del proyecto consumidor.
      Ese .targets corre sonar-sync desde tools/sonar-sync antes de compilar.
    -->
    <None Include="build\Lainco.Analyzers.targets"
          Pack="true"
          PackagePath="buildTransitive/Lainco.Analyzers.targets"
          Visible="false" />

    <None Include="..\..\..\tools\sonar-sync\src\Lainco.SonarSync\bin\$(Configuration)\net8.0\sonar-sync.dll;
                   ..\..\..\tools\sonar-sync\src\Lainco.SonarSync\bin\$(Configuration)\net8.0\sonar-sync.runtimeconfig.json;
                   ..\..\..\tools\sonar-sync\src\Lainco.SonarSync\bin\$(Configuration)\net8.0\sonar-sync.deps.json"
          Pack="true"
          PackagePath="tools/sonar-sync"
          Visible="false" />
  </ItemGroup>

</Project>
